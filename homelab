#!/bin/bash

# homelab-ssh/ (link homelab into your PATH, e.g. ~/.local/bin; settings: ~/.config/homelab/config)
# ├── homelab                                 # Main script (entry point)
# └── homelab-actions/                        # Subfolder for specific tasks
#     ├── libs/
#     │   ├── lib_check_host.sh               # Shared helper: host availability check,
#     │   │                                   #   shared confirm_next prompt, and the
#     │   │                                   #   EXIT_BACK_TO_MENU exit-code convention
#     │   └── action_sync_file_secure.sh      # Generic password-prompting sync (used by
#     │                                       #   zshrc, nanorc, sshrc, sshd_config, notify-os-updates)
#     ├── action_os_update.sh                 # APT update, upgrade, autoremove, clean
#     ├── action_docker_update.sh             # Update selected Docker Compose stack(s), auto-detected via SSH
#     ├── action_custom_command.sh            # Custom ad-hoc command
#     ├── action_sync_zshrc.sh                # Global /etc/zsh/zshrc, joined from zsh parts (ZSH_PARTS_API)
#     ├── action_sync_nanorc.sh               # Global /etc/nanorc sync
#     ├── action_sync_sshrc.sh                # Global /etc/ssh/sshrc sync
#     ├── action_sync_sshd_config.sh          # Global /etc/ssh/sshd_config sync
#     ├── action_sync_sudoers_homelab.sh      # Global /etc/sudoers.d/homelab sync
#     └── action_sync_notify-os-updates.sh    # Global /usr/local/bin/notify-os-updates.sh sync
#
# The action list shown in STEP 2 below is defined by the ACTIONS array in
# this file, in display order - to add/remove/reorder an action, only that
# array needs to change (no renumbering of case statements needed).
#
# Action scripts exit with EXIT_BACK_TO_MENU (STEP 2, same hosts) or, when
# finished, EXIT_MAIN_MENU (STEP 1) - see homelab-actions/libs/lib_check_host.sh.

SSH_CONFIG="$HOME/.ssh/config"
# Next to this script, also when it's started through a link (e.g. ~/.local/bin/homelab)
ACTIONS_DIR="$(dirname "$(realpath "$0")")/homelab-actions"

# Shared helpers: menu colors/menu_title/pick/ask and the EXIT_* codes, so this
# script and the action scripts always agree on the same values.
source "$ACTIONS_DIR/libs/lib_check_host.sh" || exit 1
trap 'echo -ne "\033[0m"' EXIT # don't leave a menu color on after Ctrl+C

if [ ! -f "$SSH_CONFIG" ]; then
    echo -e "\033[1;31m[!] File $SSH_CONFIG does not exist!\033[0m"
    exit 1
fi

# Every menu on a new screen; NOTE is shown on top of it (e.g. an invalid choice).
# After an action the next menu goes under its output instead (KEEP), so its
# results stay readable.
NOTE="" KEEP=""
screen() {
    if [ -n "$KEEP" ]; then echo; else new_screen; fi
    [ -n "$NOTE" ] && echo -e "$NOTE\n"
    NOTE="" KEEP=""
}

# Main loop to allow going back between menus
while true; do

    # --- STEP 1: SELECT TARGET TAG ---
    # Sort unique tags alphabetically so the tag menu stays readable
    ALL_TAGS=($(grep '# TAGS:' "$SSH_CONFIG" | sed 's/[#,]/ /g' | awk -F'TAGS:' '{print $2}' | tr ' ' '\n' | grep -v '^$' | sort -u))

    if [ ${#ALL_TAGS[@]} -eq 0 ]; then
        echo -e "\033[1;31m[!] Cannot find any lines with '# TAGS: ...' in ~/.ssh/config\033[0m"
        exit 1
    fi

    screen
    menu_title MAIN "=== MAIN MENU: SELECT TAG ==="
    ROWS=()
    for i in "${!ALL_TAGS[@]}"; do
        # Display index+1 so numbering starts at [1]
        ROWS+=("$((i+1))|${ALL_TAGS[$i]}")
    done
    pick TAG_REPLY MAIN 0 "Choose target tag number: " "${ROWS[@]}" "q|Quit"
    echo ""

    if [[ "$TAG_REPLY" == "q" || "$TAG_REPLY" == "Q" ]]; then
        echo "Quit."
        exit 0
    fi

    if [[ "$TAG_REPLY" == "b" || "$TAG_REPLY" == "B" ]]; then
        # Already the top-level menu, so "back" just redraws it.
        continue
    fi

    # Validate the number (between 1 and the number of tags)
    if ! [[ "$TAG_REPLY" =~ ^[0-9]+$ ]] || [ "$TAG_REPLY" -le 0 ] || [ "$TAG_REPLY" -gt "${#ALL_TAGS[@]}" ]; then
        NOTE="\033[1;31m[!] Invalid choice: $TAG_REPLY\033[0m"
        continue
    fi

    # Convert to 0-index for the Bash array
    ACTUAL_TAG_INDEX=$((TAG_REPLY-1))
    SELECTED_TAG="${ALL_TAGS[$ACTUAL_TAG_INDEX]}"

    # Find hosts matching the selected tag - NO MORE SORT (keeps ssh/config order)
    MATCHED_HOSTS=()
    while read -r host; do
        if [ -n "$host" ]; then
            MATCHED_HOSTS+=("$host")
        fi
    # A whole tag has to be equal: "web" doesn't pick a host tagged "webserver"
    done < <(awk -v tag="$SELECTED_TAG" '
        /^Host / { host=$2 }
        /# TAGS:/ {
            sub(/.*# TAGS:/, "")
            n = split($0, tags, /[ ,#]+/)
            for (i = 1; i <= n; i++) if (tags[i] == tag) { print host; break }
        }
    ' "$SSH_CONFIG")

    # --- STEP 1b: SUB-SELECT INDIVIDUAL HOST OR ALL ---
    # Own loop, so [b] in the action menu lands back here (same tag kept).
    while true; do
        screen
        menu_title HOST "=== HOST MENU: TAG [$SELECTED_TAG] ==="
        ROWS=("|ALL HOSTS IN THIS TAG")
        for i in "${!MATCHED_HOSTS[@]}"; do
            # Display index+1 so numbering starts at [1]
            ROWS+=("$((i+1))|${MATCHED_HOSTS[$i]}")
        done
        pick HOST_REPLY HOST 1 "Choose host number(s) (e.g. 1,3), [Enter] all or [b] main menu: " \
            "${ROWS[@]}" "b|Back to main menu" "q|Quit"

        if [[ "$HOST_REPLY" == "q" || "$HOST_REPLY" == "Q" ]]; then
            echo "Quit."
            exit 0
        fi

        if [[ "$HOST_REPLY" == "b" || "$HOST_REPLY" == "B" ]]; then
            continue 2
        fi

        # Determine final host array based on user input
        FINAL_HOSTS=()
        if [ -z "$HOST_REPLY" ]; then
            # User pressed Enter -> select all matched hosts
            FINAL_HOSTS=("${MATCHED_HOSTS[@]}")
        else
            # One or more numbers, separated by commas and/or spaces
            IFS=', ' read -ra PICKS <<< "$HOST_REPLY"
            for p in "${PICKS[@]}"; do
                if ! [[ "$p" =~ ^[0-9]+$ ]] || [ "$p" -le 0 ] || [ "$p" -gt "${#MATCHED_HOSTS[@]}" ]; then
                    NOTE="\033[1;31m[!] Invalid host selection: $p\033[0m"
                    continue 2
                fi
                H="${MATCHED_HOSTS[$((p-1))]}"
                [[ " ${FINAL_HOSTS[*]} " == *" $H "* ]] || FINAL_HOSTS+=("$H") # skip duplicates
            done
        fi

        # --- STEP 2: SELECT ACTION ---
        # This is its own inner loop now: redrawing it (after an invalid
        # choice, or after an action asks to go back via EXIT_BACK_TO_MENU)
        # only redisplays this menu, keeping the tag/host selection from above
        # instead of throwing it away.
        while true; do
            # Ordered list of actions: "Label|script_filename". To add, remove, or
            # reorder an action, only this array needs to change - the menu and the
            # dispatch below are both generated from it, so numbering never drifts.
            ACTIONS=(
                "System Update (APT update, upgrade, autoremove, clean)|action_os_update.sh"
                "Update Docker Compose Stack(s)|action_docker_update.sh"
                "Sync sshd_config globally (to /etc/ssh/sshd_config)|action_sync_sshd_config.sh"
                "Sync sshrc globally (to /etc/ssh/sshrc)|action_sync_sshrc.sh"
                "Sync sudoers.d/homelab globally (to /etc/sudoers.d/homelab)|action_sync_sudoers_homelab.sh"
                "Sync .nanorc globally (to /etc/nanorc)|action_sync_nanorc.sh"
                "Sync .zshrc globally (to /etc/zsh/zshrc)|action_sync_zshrc.sh"
                "Sync notify-os-updates.sh globally (to /usr/local/bin/notify-os-updates.sh)|action_sync_notify-os-updates.sh"
                "Run Custom Ad-Hoc Command|action_custom_command.sh"
            )

            screen
            echo -e "\033[1;32m➜ Selected target(s):\033[0m"
            for H in "${FINAL_HOSTS[@]}"; do
                echo "  - $H"
            done
            echo -e "--------------------------------------------"
            menu_title ACTION "=== ACTION MENU ==="
            ROWS=()
            for i in "${!ACTIONS[@]}"; do
                ROWS+=("$((i+1))|${ACTIONS[$i]%%|*}")
            done
            pick ACTION_REPLY ACTION 0 "Choose action number, [m] main menu or [b] host menu: " \
                "${ROWS[@]}" "m|Back to main menu" "b|Back to host menu" "q|Quit"
            echo ""

            if [[ "$ACTION_REPLY" == "m" || "$ACTION_REPLY" == "M" ]]; then
                continue 3
            fi

            if [[ "$ACTION_REPLY" == "b" || "$ACTION_REPLY" == "B" ]]; then
                continue 2
            fi

            if [[ "$ACTION_REPLY" == "q" || "$ACTION_REPLY" == "Q" ]]; then
                echo "Quit."
                exit 0
            fi

            # Enter alone picks the first (default) action
            [ -z "$ACTION_REPLY" ] && ACTION_REPLY=1

            if ! [[ "$ACTION_REPLY" =~ ^[0-9]+$ ]] || [ "$ACTION_REPLY" -le 0 ] || [ "$ACTION_REPLY" -gt "${#ACTIONS[@]}" ]; then
                NOTE="\033[1;31m[!] Invalid action: $ACTION_REPLY\033[0m"
                continue
            fi

            ACTION_SCRIPT="${ACTIONS[$((ACTION_REPLY-1))]#*|}"
            export TARGET_HOSTS="${FINAL_HOSTS[*]}"
            bash "$ACTIONS_DIR/$ACTION_SCRIPT"
            ACTION_EXIT=$?

            # [b] / errors inside an action land back here (same hosts);
            # a finished action goes to the main menu. Only [q] ends the program.
            if [ "$ACTION_EXIT" -eq "$EXIT_BACK_TO_MENU" ]; then
                echo -e "\033[1;36m↩ Back to action menu (same target(s) kept)...\033[0m"
                KEEP=1
                continue
            fi
            if [ "$ACTION_EXIT" -eq "$EXIT_MAIN_MENU" ]; then
                echo -e "\033[1;36m↩ Back to main menu...\033[0m"
                KEEP=1
                continue 3
            fi

            exit "$ACTION_EXIT"
        done
    done
done
